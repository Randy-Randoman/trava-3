# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LLM (swappable — set the one you want to use)
LLM_PROVIDER=google  # "google" or "anthropic"
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Affiliate (CJ / Commission Junction)
CJ_PID=
CJ_AID=

# Search
TAVILY_API_KEY=

# Frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Auth (set to true to enable Supabase auth)
AUTH_ENABLED=false
